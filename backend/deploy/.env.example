# Copy to .env next to this file and fill it in. .env is never committed - the
# repository's .gitignore already ignores it, and the Docker build context
# excludes it. Every variable below must be present: the prod profile has no
# fallback for any of them, so a missing one stops the API at startup with
# "Could not resolve placeholder".
#
# Generate every secret with:   openssl rand -base64 32

# ---------------------------------------------------------------- the domain
# The site address Caddy serves. A bare domain gets automatic HTTPS; use
# http://localhost (with the scheme) to test the stack locally over plain HTTP.
BRAND_DOMAIN=app.example.com
# Host ports the proxy publishes. Leave them alone in production.
BRAND_HTTP_PORT=80
BRAND_HTTPS_PORT=443

# ------------------------------------------------------------------- the API
# Absolute base of this server: avatar URLs and the password-reset link are
# built from it, so it must be the address a phone can actually open.
BRAND_PUBLIC_BASE_URL=https://app.example.com
# Base64, at least 32 bytes decoded. Rotating it signs every device out.
BRAND_JWT_SECRET=
# [B11] The account with this email is promoted to super_admin and approved on
# startup. Register in the app first, then restart the api once. May be left
# empty afterwards, but the line must exist.
BRAND_BOOTSTRAP_ADMIN_EMAIL=founder@example.com
# Comma-separated browser origins. The native app sends no Origin header, so
# this is the admin page and anything web. Never a wildcard.
BRAND_CORS_ALLOWED_ORIGINS=https://app.example.com

# Optional: the image to run instead of building on the VM. Unset builds from
# this checkout with `docker compose -f docker-compose.prod.yml build api`.
#BRAND_IMAGE=ghcr.io/OWNER/REPO/brand-api:1.0.0

# -------------------------------------------------------------- the database
BRAND_DB_NAME=brand
BRAND_DB_USER=brand
# Generate this one too; it is the database password, not a placeholder.
BRAND_DB_PASSWORD=
# Hikari pool ceiling. 10 is right for one small VM.
#BRAND_DB_POOL_SIZE=10

# ------------------------------------------------------------------ the mail
# The From address on the password-reset mail.
BRAND_MAIL_FROM=no-reply@example.com
# false writes the reset link to the log at INFO instead of sending it. That is
# a pre-launch affordance only: set it true before real users register.
BRAND_MAIL_ENABLED=false
#
# SMTP is Spring's own configuration and is read straight from the environment.
# Leave these COMMENTED OUT until you have credentials: setting SPRING_MAIL_HOST
# to an empty string still creates a mail sender, and an empty host fails at
# send time instead of at start-up.
#SPRING_MAIL_HOST=smtp.example.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=
#SPRING_MAIL_PASSWORD=
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ------------------------------------------------------------------ the push
# [B8] false still writes the outbox and renders the copy in the device's
# language; it hands the rows to the logging sender instead of Expo.
BRAND_PUSH_ENABLED=false
# From expo.dev. Blank sends the requests unauthenticated, which Expo allows
# until the project turns enhanced security on. The line must exist either way.
BRAND_EXPO_ACCESS_TOKEN=

# --------------------------------------------------------------- the backups
# Where the nightly dump and the avatar tarball land on the host.
BRAND_BACKUP_DIR=./backups
# Hour of the day, UTC, two digits.
BRAND_BACKUP_HOUR=03
BRAND_BACKUP_RETENTION_DAYS=14
