# Copy to `.env` and edit. Expo inlines every EXPO_PUBLIC_* value into the JS
# bundle at build time, so put NOTHING secret in here.
#
# NOTE: .gitignore currently ignores `.env*.local` but not `.env` — name your
# local copy `.env.local` if you do not want it committed.

# Origin of the Spring Boot backend, no trailing slash.
#   set   -> the app talks to that server (dev and production alike)
#   unset -> dev falls back to the in-memory MockApi; a production build throws
# Use the LAN address of the machine running the backend, not localhost: a
# phone or a simulator resolves localhost to itself.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080

# Dev-only entry point override. `gallery` renders the component gallery
# instead of the app, which is how the library is checked against /design.
# Anything else (or unset) boots the app.
# EXPO_PUBLIC_SCREEN=gallery
